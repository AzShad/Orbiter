<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Orbiter</AssemblyName>
    <RootNamespace>Orbiter</RootNamespace>
    <ApplicationIcon>Assets\orbiter.ico</ApplicationIcon>
    <Product>Orbiter</Product>
    <Description>Client SSH / SFTP pour Windows</Description>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\*.*" LogicalName="web/%(Filename)%(Extension)" />
    <Resource Include="Assets\orbiter.ico" />
  </ItemGroup>

</Project>
