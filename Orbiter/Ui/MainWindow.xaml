<Window x:Class="Orbiter.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbiter" Height="780" Width="1280" MinWidth="800" MinHeight="480"
        Icon="pack://application:,,,/Orbiter;component/Assets/orbiter.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre supérieure -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="2,0,16,0">
                    <Run Text="&#xE756;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Accent}"/>
                    <Run Text=" Orbiter"/>
                </TextBlock>
                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="NewSession_Click" Padding="12,5">
                    <TextBlock><Run Text="&#xE710;" FontFamily="{StaticResource Icons}"/><Run Text="  Nouvelle session"/></TextBlock>
                </Button>

                <Grid DockPanel.Dock="Left" Margin="16,0,0,0" Width="300">
                    <TextBox x:Name="QuickBox" Height="30" KeyDown="QuickBox_KeyDown" TextChanged="QuickBox_TextChanged"
                             ToolTip="Connexion rapide : utilisateur@hôte[:port]  (Entrée = SSH)"/>
                    <TextBlock x:Name="QuickHint" Text="Connexion rapide : utilisateur@hôte:port" IsHitTestVisible="False"
                               Foreground="{DynamicResource Placeholder}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="SSH" Margin="6,0,0,0" Click="QuickSsh_Click"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="SFTP" Margin="6,0,0,0" Click="QuickSftp_Click"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="About_Click" ToolTip="À propos">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="15"/>
                </Button>
                <Button x:Name="BackupBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Backup_Click"
                        ToolTip="Sauvegarder ou restaurer les sessions">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Icons}" FontSize="15"/>
                </Button>
                <Button x:Name="ThemeBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Theme_Click"
                        ToolTip="Basculer thème clair / sombre">
                    <TextBlock x:Name="ThemeGlyph" Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="15"/>
                </Button>
                <Button x:Name="ReconnectBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="Reconnect_Click" IsEnabled="False">
                    <TextBlock><Run Text="&#xE72C;" FontFamily="{StaticResource Icons}"/><Run Text="  Reconnecter"/></TextBlock>
                </Button>
                <Button x:Name="SftpToggleBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="ToggleSftp_Click" IsEnabled="False">
                    <TextBlock><Run Text="&#xE8B7;" FontFamily="{StaticResource Icons}"/><Run Text="  Panneau SFTP"/></TextBlock>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panneau des sessions -->
            <Grid Background="{DynamicResource Sidebar}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SESSIONS" Margin="12,12,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                <Grid Grid.Row="1" Margin="8,0,8,6">
                    <TextBox x:Name="SearchBox" Height="28" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="&#xE721;  Rechercher" IsHitTestVisible="False" Foreground="{DynamicResource Placeholder}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Segoe UI, Segoe MDL2 Assets"/>
                </Grid>
                <ListBox x:Name="SessionList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="SessionList_DoubleClick" KeyDown="SessionList_KeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="4,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Endpoint, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ouvrir" Click="OpenSession_Click" FontWeight="SemiBold"/>
                            <MenuItem Header="Ouvrir en SSH (terminal)" Click="OpenSsh_Click"/>
                            <MenuItem Header="Ouvrir en SFTP (fichiers)" Click="OpenSftp_Click"/>
                            <Separator/>
                            <MenuItem Header="Modifier…" Click="EditSession_Click"/>
                            <MenuItem Header="Dupliquer" Click="DuplicateSession_Click"/>
                            <MenuItem Header="Supprimer" Click="DeleteSession_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6">
                    <Button Style="{StaticResource FlatButton}" Click="NewSession_Click" ToolTip="Nouvelle session">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="EditSession_Click" ToolTip="Modifier">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="DuplicateSession_Click" ToolTip="Dupliquer">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="DeleteSession_Click" ToolTip="Supprimer">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Border}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Onglets + contenu -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="6,6,6,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" MinHeight="30"/>
                    </ScrollViewer>
                </Border>
                <Grid x:Name="SessionHost" Grid.Row="1"/>
                <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="54" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Bienvenue dans Orbiter" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" LineHeight="20">
                        Créez une session avec « Nouvelle session », double-cliquez sur une session enregistrée,
                        ou tapez utilisateur@hôte dans la connexion rapide.
                        <LineBreak/><LineBreak/>
                        Terminal : sélection = copier · clic droit = coller · Ctrl+molette = taille du texte.
                        <LineBreak/>
                        SFTP : glissez-déposez des fichiers depuis l'Explorateur pour les envoyer, double-cliquez pour ouvrir/modifier.
                    </TextBlock>
                    <Button Style="{StaticResource PrimaryButton}" Content="Nouvelle session" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Click="NewSession_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
